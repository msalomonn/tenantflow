{
  "name": "tenantflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "dev": "tsx --env-file=.env apps/api/src/server.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "start": "NODE_ENV=production tsx --env-file=.env apps/api/src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file=.env --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run build && npm test && npm run test:e2e",
    "audit": "npm audit --package-lock-only --audit-level=info --include=dev --include=optional --include=peer"
  },
  "dependencies": {
    "better-auth": "1.7.13",
    "express": "5.3.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5"
  }
}
